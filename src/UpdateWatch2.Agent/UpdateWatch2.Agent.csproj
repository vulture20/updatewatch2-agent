<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-UpdateWatch2.Agent-d4d3427f-7dd8-4ee6-9e1b-d9d4c9767ff5</UserSecretsId>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <!-- Also embedded into the compiled binary's Windows file-version
         resource (Explorer's Details tab: Company/Product/Copyright),
         alongside <Version> below — previously unset, so those fields were
         simply blank on a real installed agent, the same class of gap
         <Version> itself was added to fix. Matches the copyright line
         already used in README.md/the NSIS installer's own version
         resource (installer/nsis/setup.nsi's LegalCopyright key). -->
    <Authors>Thorsten Schröpel</Authors>
    <Company>Thorsten Schröpel</Company>
    <Product>UpdateWatch2 Agent</Product>
    <Copyright>Copyright (C) 2026 Thorsten Schröpel</Copyright>
    <!-- Embedded into the compiled Windows binary (Explorer, Task Manager,
         services.msc, etc.); ignored on non-Windows builds. Same source as
         installer/nsis/icon.ico — see logos/ at the workspace root and
         CLAUDE.md for how to regenerate both. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- Without this, an unset <Version> defaults to 1.0.0.0/1.0.0
         regardless of AgentVersion.Current, so the compiled binary's own
         Windows file-version resource (Explorer's Details tab: File
         version/Product version) never matched the actual agent version —
         confirmed on a real installed agent, where the only way to tell
         two builds apart on disk was the file's timestamp. Read from the
         repo-root VERSION file (the same source release.yml already reads
         for the NSIS installer's own -DVERSION= and the fpm package
         version) rather than duplicating the literal here, so there's
         still exactly one place to bump — AgentVersion.cs's own doc
         comment already asks for that discipline for the *runtime-reported*
         version; this now covers the *compiled-binary metadata* the same
         way, from the same file, without the two ever needing to be
         reconciled by hand.
         IncludeSourceRevisionInInformationalVersion=false keeps
         "Product version" as a clean SemVer string (no "+<git-sha>"
         suffix) even if a future SourceLink-style package ever turns that
         behavior on by default. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../VERSION').Trim())</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>
</Project>
