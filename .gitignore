# Secrets & certificates — never commit
certs/
*.pfx
*.pem
*.key
*.crt
*.p12

# Local config / registry exports
*.reg
config.local.*
!config.example.*

# Logs
logs/
*.log

# .NET build output
bin/
obj/
*.user

# Local release-packaging output (see .github/workflows/release.yml) —
# `dotnet publish` output and the installer packages built from it
publish/
dist/
installer/nsis/*.exe
